{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSHPilot",
  "version": "0.1.0",
  "identifier": "ai.dshpilot.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DSHPilot",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* http://localhost:*; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; img-src 'self' data: blob: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline' http://127.0.0.1:* http://localhost:*; script-src 'self' 'unsafe-inline' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../../runtime/current": "runtime",
      "../../../runtime/current.json": "runtime/current.json"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyRjFEMTVBQkFDNzM5MTAKUldRUU9jZTZXdEh4Z3FIQ09KcVJKVDRxeEwyVThrNjBEOEF1TU5adWVBa1VtWDdtQkZLZGREZkwK",
      "endpoints": [
        "https://github.com/zoomc/dshpilot/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["dshpilot"]
      }
    }
  }
}
